{#
/**
 * @file
 * The members' workspace on a group page: Create Content and Group Content.
 *
 * Available variables:
 * - create_links: render array of create-content links, or null when the
 *   viewer may not create anything here.
 * - content_view: render array of the group's content listing, or null when
 *   the viewer may not see it.
 *
 * Both tabs are always rendered, even when a pane has nothing in it. An empty
 * pane with a label explains itself; a missing tab just leaves the reader
 * wondering what they are looking at, and with one pane there was no heading
 * naming the listing at all.
 *
 * Bootstrap's tab component drives this (manzanita loads madrone/bootstrap
 * site-wide). Hidden panes stay in the DOM, so the view's AJAX pager keeps
 * working in the inactive tab.
 *
 * @see \Drupal\osu_cas_multisite_groups\Plugin\Block\CasGroupAddContentBlock
 */
#}
{# Open on the tab that has something in it. #}
{% set create_active = create_links is not empty %}
<div class="cas-group-workspace">

  <ul class="cas-group-workspace__tablist nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link{{ create_active ? ' active' }}"
              id="cas-group-tab-create"
              data-bs-toggle="tab"
              data-bs-target="#cas-group-pane-create"
              type="button"
              role="tab"
              aria-controls="cas-group-pane-create"
              aria-selected="{{ create_active ? 'true' : 'false' }}">{{ 'Create Content'|t }}</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link{{ create_active ? '' : ' active' }}"
              id="cas-group-tab-content"
              data-bs-toggle="tab"
              data-bs-target="#cas-group-pane-content"
              type="button"
              role="tab"
              aria-controls="cas-group-pane-content"
              aria-selected="{{ create_active ? 'false' : 'true' }}">{{ 'Group Content'|t }}</button>
    </li>
  </ul>

  <div class="cas-group-workspace__panes tab-content">
    <div class="cas-group-workspace__pane tab-pane fade{{ create_active ? ' show active' }}"
         id="cas-group-pane-create"
         role="tabpanel"
         aria-labelledby="cas-group-tab-create"
         tabindex="0">
      {% if create_links %}
        {{ create_links }}
      {% else %}
        <p class="cas-group-workspace__empty">
          {{ 'You do not have permission to create content in this group.'|t }}
        </p>
      {% endif %}
    </div>

    <div class="cas-group-workspace__pane tab-pane fade{{ create_active ? '' : ' show active' }}"
         id="cas-group-pane-content"
         role="tabpanel"
         aria-labelledby="cas-group-tab-content"
         tabindex="0">
      {% if content_view %}
        {{ content_view }}
      {% else %}
        <p class="cas-group-workspace__empty">
          {{ "You do not have permission to see this group's content."|t }}
        </p>
      {% endif %}
    </div>
  </div>

</div>

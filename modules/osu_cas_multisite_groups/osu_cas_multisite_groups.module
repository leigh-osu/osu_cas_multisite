<?php

/**
 * @file
 * OSU CAS Multisite Groups — group and domain support for the CAS platform.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\group\Entity\GroupRelationship;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_FORM_ID_alter() for node_osu_profile_edit_form.
 *
 * Profile owners reach this form through the basic_group-member
 * 'update own group_node:osu_profile entity' permission. They may edit their
 * own profile content, but not re-home the profile (the entitygroupfield
 * Groups widget) or unpublish it. The gate cannot be 'administer nodes':
 * ordinary members carry it via the group_content_author role. Instead, trim
 * the form when someone edits the profile they own, unless they hold
 * 'bypass node access' (dx_administrator / architect / manage_content) —
 * group editors working on other people's profiles are unaffected.
 */
function osu_cas_multisite_groups_form_node_osu_profile_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $account = \Drupal::currentUser();
  $node = $form_state->getFormObject()->getEntity();
  if ($node->getOwnerId() == $account->id() && !$account->hasPermission('bypass node access')) {
    $form['entitygroupfield']['#access'] = FALSE;
    $form['status']['#access'] = FALSE;
  }
  _osu_cas_multisite_groups_hide_profile_domain_fields($form, $account);
}

/**
 * Implements hook_form_FORM_ID_alter() for node_osu_profile_form.
 *
 * The add form gets the same domain-field trim as the edit form.
 */
function osu_cas_multisite_groups_form_node_osu_profile_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _osu_cas_multisite_groups_hide_profile_domain_fields($form, \Drupal::currentUser());
}

/**
 * Hides profile domain fields from everyone but admins.
 *
 * Profiles are directory content sent to all affiliates (D7 parity, set by
 * migration and field default), so their domain assignment is bookkeeping
 * that only System Administrators / Architects ('bypass node access') should
 * see or change.
 */
function _osu_cas_multisite_groups_hide_profile_domain_fields(array &$form, $account): void {
  if ($account->hasPermission('bypass node access')) {
    return;
  }
  foreach (['field_domain_access', 'field_domain_all_affiliates', 'field_domain_source'] as $field) {
    if (isset($form[$field])) {
      $form[$field]['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_node_access_records_alter().
 *
 * Members-only content, mirroring D7's og_access "group content visibility":
 * a node flagged field_group_private carries view grants only for the groups
 * it is placed in (realm cas_group_private, gid = group id), replacing the
 * Domain Access records that would otherwise grant anonymous view. Because
 * enforcement rides the node-grants system, Views listings, search, menu
 * links and sitemaps hide these nodes from non-members automatically.
 * Unpublished nodes keep their original records — domain_unpublished already
 * restricts those correctly.
 */
function osu_cas_multisite_groups_node_access_records_alter(array &$grants, NodeInterface $node): void {
  if (!$node->isPublished()
    || !$node->hasField('field_group_private')
    || empty($node->get('field_group_private')->value)) {
    return;
  }
  $records = [];
  foreach (GroupRelationship::loadByEntity($node) as $relationship) {
    $gid = (int) $relationship->getGroupId();
    $records[$gid] = [
      'realm' => 'cas_group_private',
      'gid' => $gid,
      'grant_view' => 1,
      'grant_update' => 0,
      'grant_delete' => 0,
      'langcode' => $node->language()->getId(),
    ];
  }
  // A flagged node in no group at all stays visible only to accounts that
  // bypass node access — the D7-faithful reading of "members only" with no
  // members. That needs an explicit locking record: returning no records
  // would make core write its public 'all' fallback. gid 0 is granted to
  // nobody (hook_node_grants only ever returns real group ids).
  if (!$records) {
    $records[0] = [
      'realm' => 'cas_group_private',
      'gid' => 0,
      'grant_view' => 1,
      'grant_update' => 0,
      'grant_delete' => 0,
      'langcode' => $node->language()->getId(),
    ];
  }
  $grants = array_values($records);
}

/**
 * Implements hook_node_access().
 *
 * The grants above govern listings, search and menus, but a full node view
 * consults entity-access hooks first — and gnode answers "allowed" whenever
 * the group's anonymous/outsider role may view group content, which
 * short-circuits the grants table entirely. Forbidden beats allowed, so for
 * a flagged node this denies everyone who is not a member of one of its
 * groups. Accounts with 'bypass node access' never reach node-access hooks.
 */
function osu_cas_multisite_groups_node_access(NodeInterface $node, string $op, AccountInterface $account): \Drupal\Core\Access\AccessResultInterface {
  $neutral = \Drupal\Core\Access\AccessResult::neutral()->addCacheableDependency($node);
  if ($op !== 'view'
    || !$node->hasField('field_group_private')
    || empty($node->get('field_group_private')->value)) {
    return $neutral;
  }
  $member_gids = osu_cas_multisite_groups_node_grants($account, 'view')['cas_group_private'] ?? [];
  foreach (GroupRelationship::loadByEntity($node) as $relationship) {
    if (in_array((int) $relationship->getGroupId(), $member_gids, TRUE)) {
      return $neutral->cachePerUser();
    }
  }
  return \Drupal\Core\Access\AccessResult::forbidden('Group members only.')
    ->addCacheableDependency($node)
    ->cachePerUser();
}

/**
 * Implements hook_node_grants().
 *
 * The matching grants for cas_group_private: each authenticated user is
 * granted the ids of the groups they are a member of. Accounts with 'bypass
 * node access' (System Administrators, Architects) never reach this hook.
 */
function osu_cas_multisite_groups_node_grants(AccountInterface $account, string $op): array {
  if ($op !== 'view' || !$account->isAuthenticated()) {
    return [];
  }
  $gids = [];
  foreach (\Drupal::service('group.membership_loader')->loadByUser($account) as $membership) {
    $gids[] = (int) $membership->getGroupRelationship()->getGroupId();
  }
  return $gids ? ['cas_group_private' => $gids] : [];
}

/**
 * Implements hook_field_widget_complete_form_alter().
 *
 * Sorts the group select on node forms alphabetically.
 *
 * entitygroupfield builds its options in entity-load order — that is, by group
 * id, which for migrated content means D7 creation order and reads as random.
 * With 195 groups the list is unusable that way. The module offers no sort
 * setting, so rather than patch contrib the options are reordered here, after
 * the widget has decided which groups the user may actually post into.
 *
 * Options arrive grouped into optgroups keyed by group type label, so each
 * optgroup is sorted on its own; a flat list is sorted directly. strcasecmp
 * rather than natcasesort so "Fun Facts" files before "Funding Opportunities"
 * — natural ordering skips the space and reverses them.
 */
function osu_cas_multisite_groups_field_widget_complete_form_alter(array &$field_widget_complete_form, FormStateInterface $form_state, array $context): void {
  $plugin_id = $context['widget']->getPluginId();
  if ($plugin_id !== 'entitygroupfield_select_widget') {
    return;
  }
  _osu_cas_multisite_groups_sort_group_options($field_widget_complete_form);
}

/**
 * Recursively alphabetises the #options of any select in a render array.
 *
 * The widget nests its select under wrappers that differ between the initial
 * build and the AJAX "add another" rebuild, so the element is found by walking
 * rather than by a fixed path.
 */
function _osu_cas_multisite_groups_sort_group_options(array &$element): void {
  if (isset($element['#type'], $element['#options']) && $element['#type'] === 'select' && is_array($element['#options'])) {
    foreach ($element['#options'] as &$option) {
      // An optgroup: sort the groups inside it.
      if (is_array($option)) {
        uasort($option, fn($a, $b) => strcasecmp((string) $a, (string) $b));
      }
    }
    unset($option);
    // A flat list of groups, with no optgroups.
    if (!array_filter($element['#options'], 'is_array')) {
      uasort($element['#options'], fn($a, $b) => strcasecmp((string) $a, (string) $b));
    }
  }
  foreach (Element::children($element) as $key) {
    if (is_array($element[$key])) {
      _osu_cas_multisite_groups_sort_group_options($element[$key]);
    }
  }
}

/**
 * Implements hook_views_data_alter().
 *
 * Group support for content listings without join fan-out: a computed
 * primary-group field on nodes (CasNodeGroups) and a select-friendly
 * parent-group filter (CasGroupSelect).
 */
function osu_cas_multisite_groups_views_data_alter(array &$data) {
  if (isset($data['node_field_data'])) {
    $data['node_field_data']['cas_node_groups'] = [
      'title' => t('Primary group (computed)'),
      'help' => t('Alphabetically first group the node is placed in; a correlated subquery rather than a join, so rows never duplicate and the column stays click-sortable.'),
      'field' => [
        'id' => 'cas_node_groups',
        'click sortable' => TRUE,
      ],
    ];
  }
  if (isset($data['groups_field_data'])) {
    $data['groups_field_data']['cas_my_groups'] = [
      'title' => t('My groups (or all, when administering every group)'),
      'help' => t("Limits the listing to the current user's groups; holders of 'administer all cas groups' see every group."),
      'real field' => 'id',
      'filter' => ['id' => 'cas_my_groups'],
    ];
    $data['groups_field_data']['cas_my_group_roles'] = [
      'title' => t('My roles in this group'),
      'help' => t('The roles the current user holds in the group on this row, read through the membership API.'),
      'field' => [
        'id' => 'cas_my_group_roles',
        'click sortable' => TRUE,
      ],
    ];
  }
  if (isset($data['group_relationship_field_data'])) {
    $data['group_relationship_field_data']['cas_membership_roles'] = [
      'title' => t('Membership roles'),
      'help' => t("The roles this membership carries, including synchronized ones. group_relationship__group_roles ships no views data, so the roles are read through the membership API instead."),
      'field' => [
        'id' => 'cas_membership_roles',
        'click sortable' => FALSE,
      ],
    ];
  }
  if (isset($data['node_field_data'])) {
    $data['node_field_data']['cas_group_nodes'] = [
      'title' => t('Nodes in a group (contextual)'),
      'help' => t('Limit nodes to one group by EXISTS subquery, so node access still applies and rows never duplicate.'),
      'real field' => 'nid',
      'argument' => ['id' => 'cas_group_nodes'],
    ];
  }
  if (isset($data['node_field_data'])) {
    $data['node_field_data']['gid_select'] = [
      'title' => t('Parent group (dropdown)'),
      'help' => t('Filter by parent group with an alphabetical dropdown (EXISTS subquery, no join).'),
      'real field' => 'nid',
      'filter' => ['id' => 'cas_group_select'],
    ];
  }
}

/**
 * Implements hook_theme().
 */
function osu_cas_multisite_groups_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    // The group footer card (CasGroupFooterBlock): columns is a keyed subset
    // of map / contact / info / col4, each already a render array except
    // contact (address parts, email, phone, hours, social link list).
    'cas_group_footer' => [
      'variables' => [
        'group' => NULL,
        'columns' => [],
        'column_count' => 0,
        'attributes' => [],
      ],
    ],
    // The members' workspace on a group page (CasGroupAddContentBlock):
    // create-content links and, for members, the group's content listing.
    'cas_group_workspace' => [
      'variables' => [
        'create_links' => NULL,
        'content_view' => NULL,
      ],
    ],
    // The /dashboard page (DashboardController). See the controller for the
    // shape of each variable.
    'cas_dashboard' => [
      'variables' => [
        'display_name' => '',
        'account_link' => NULL,
        'profile_link' => NULL,
        'site_roles' => [],
        'groups_view' => NULL,
        'content_view' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_user_login().
 *
 * Lands users on their dashboard after signing in. Setting 'destination'
 * rather than returning a response keeps every login path working the same
 * way: the CAS ServiceController and core's UserLoginForm both defer to
 * Drupal's RedirectResponseSubscriber, which honours this parameter.
 *
 * A destination already on the request means the user was going somewhere
 * specific — a protected link that bounced them through login — so it is left
 * alone. Everything else lands on the dashboard, including the one-time login
 * link, which core otherwise sends to the account form: CAS owns passwords
 * here (cas.settings restrict_password_management), so there is nothing to set
 * on that form and no reason to strand anyone there.
 */
function osu_cas_multisite_groups_user_login($account): void {
  $request = \Drupal::request();
  $destination = $request->query->get('destination') ?? $request->request->get('destination');

  // A destination pointing back into the login flow would bounce the user
  // straight back out of it, so it counts as no destination at all.
  if (is_string($destination) && $destination !== ''
    && !preg_match('#^/?user/(login|reset|password)#', $destination)) {
    return;
  }

  $request->query->set('destination', Url::fromRoute('osu_cas_multisite_groups.dashboard')->toString());
}

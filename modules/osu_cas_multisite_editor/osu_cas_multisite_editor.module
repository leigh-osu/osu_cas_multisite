<?php

/**
 * @file
 * CKEditor configuration for the CAS platform.
 */

use Drupal\osu_cas_multisite_editor\Plugin\CKEditorPlugin\CasButtons;

/**
 * Implements hook_ckeditor_plugin_info_alter().
 *
 * Swaps the button picker for the CAS one. osu_ckeditor_plugins is an upstream
 * osu-wams package, so it is not edited here; repointing the plugin class is
 * the documented way to change what it loads, and it leaves the upstream
 * module free to move on.
 *
 * @see \Drupal\osu_cas_multisite_editor\Plugin\CKEditorPlugin\CasButtons
 */
function osu_cas_multisite_editor_ckeditor_plugin_info_alter(array &$plugins) {
  if (isset($plugins['osu_ckeditor_plugins_osu_buttons'])) {
    $plugins['osu_ckeditor_plugins_osu_buttons']['class'] = CasButtons::class;
    $plugins['osu_ckeditor_plugins_osu_buttons']['provider'] = 'osu_cas_multisite_editor';
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * Rides the modal-focus fix along with CKEditor itself, so any editor that
 * ends up inside a jQuery UI modal (layout_builder_modal block forms) gets
 * workable dialogs. See js/ckeditor-modal-focus.js for the why.
 */
function osu_cas_multisite_editor_library_info_alter(array &$libraries, string $extension): void {
  if ($extension === 'ckeditor' && isset($libraries['drupal.ckeditor'])) {
    $libraries['drupal.ckeditor']['dependencies'][] = 'osu_cas_multisite_editor/ckeditor-modal-focus';
  }
}
